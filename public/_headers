# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Default for assets is "public, max-age=0, must-revalidate" (a round trip per file).

# Pinyin recordings: the app always requests them with ?v=<content hash> (pinyinAudioManifest.ts),
# so a new build gets new URLs and old ones can be cached for good.
/audio/pinyin/*.mp3
  Cache-Control: public, max-age=31536000, immutable

/audio/pinyin/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/audio/pinyin/LICENSE.txt
  Cache-Control: public, max-age=86400

# Vite output: file names carry a content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
